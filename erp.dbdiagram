// Garment ERP Database Diagram - Current Implementation
// Copy this content to https://dbdiagram.io/d to visualize

Project garment_erp {
  database_type: 'PostgreSQL'
  Note: '''
    Garment ERP System - Current Implementation
    Implemented: Users, Departments, Employees
    Future: Products, Orders, Inventory, Finance
  '''
}

// Currently Implemented Tables
Table Users {
  id integer [pk, increment]
  username varchar(255) [unique, not null]
  email varchar(255) [unique, not null]
  password varchar(255) [not null]
  role enum('super-admin', 'admin', 'manager', 'employee') [default: 'employee']
  status enum('active', 'inactive') [default: 'active']
  createdAt timestamp [default: `now()`]
  updatedAt timestamp [default: `now()`]
  
  Note: 'User authentication and authorization'
}

Table Departments {
  id integer [pk, increment]
  name varchar(255) [unique, not null]
  status varchar(255) [default: 'active']
  description text
  createdAt timestamp [default: `now()`]
  updatedAt timestamp [default: `now()`]
  
  Note: 'Department management'
}

Table Employees {
  id integer [pk, increment]
  firstName varchar(255) [not null]
  lastName varchar(255) [not null]
  email varchar(255) [unique, not null]
  role varchar(255) [not null]
  salary integer [not null]
  status varchar(255) [default: 'active']
  departmentId integer
  createdAt timestamp [default: `now()`]
  updatedAt timestamp [default: `now()`]
  
  Note: 'Employee information and management'
}

// Current Relationships
Ref: Employees.departmentId > Departments.id

