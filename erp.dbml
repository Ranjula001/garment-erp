// Garment ERP Database Schema
// Based on current Sequelize models in the project

Project garment_erp {
  database_type: 'PostgreSQL'
  Note: 'Garment ERP System Database Schema - Current Implementation'
}

// User Management & Authentication (Currently Implemented)
Table Users {
  id integer [primary key, increment]
  username varchar(255) [not null, unique, note: 'Length 4-20 chars']
  email varchar(255) [not null, unique, note: 'Valid email format']
  password varchar(255) [not null, note: 'Hashed password, length 6-100 chars']
  role enum('super-admin', 'admin', 'manager', 'employee') [not null, default: 'employee']
  status enum('active', 'inactive') [not null, default: 'active']
  createdAt timestamp [not null, default: `now()`]
  updatedAt timestamp [not null, default: `now()`]
}

// Department Management (Currently Implemented)
Table Departments {
  id integer [primary key, increment]
  name varchar(255) [not null, unique]
  status varchar(255) [not null, default: 'active']
  description text [null]
  createdAt timestamp [not null, default: `now()`]
  updatedAt timestamp [not null, default: `now()`]
}

// Employee Management (Currently Implemented)
Table Employees {
  id integer [primary key, increment]
  firstName varchar(255) [not null]
  lastName varchar(255) [not null]
  email varchar(255) [not null, unique]
  role varchar(255) [not null]
  salary integer [not null]
  status varchar(255) [not null, default: 'active']
  departmentId integer [null, ref: > Departments.id]
  createdAt timestamp [not null, default: `now()`]
  updatedAt timestamp [not null, default: `now()`]
}

